#!/bin/sh
# The checks of this repository, in one place.
#   scripts/check        before a push: what the CI runs, without its fuzzing
#   scripts/check fast   while working: seconds, from Go's test cache, which
#                        reruns the packages a change reaches; no race
#                        detector, no pseudo-terminals, no lint
set -eu
cd "$(git rev-parse --show-toplevel)"

# git ls-files, because gofmt would walk into .claude/worktrees.
unformatted=$(git ls-files '*.go' | xargs gofmt -l)
if [ -n "$unformatted" ]; then
	echo "gofmt: $unformatted" >&2
	exit 1
fi
go vet ./...

case "${1:-full}" in
fast)
	go test -short -timeout 5m ./...
	;;
full)
	go test -race -count=1 -timeout 10m ./...
	golangci-lint run
	;;
*)
	echo "usage: scripts/check [fast]" >&2
	exit 2
	;;
esac
